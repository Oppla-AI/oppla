#!/usr/bin/env bash

# Test script for Windows bundling system
# Validates setup, dependencies, and script functionality

# Function for displaying help info
help_info() {
  echo "
Usage: ${0##*/} [options]
Test the Windows bundling system setup and functionality.

Options:
  -h, --help    Display this help and exit.
  -v, --verbose Show detailed test output.
  -q, --quick   Skip time-consuming tests (network checks, etc.).
"
}

# Parse arguments
verbose=false
quick=false

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            help_info
            exit 0
            ;;
        -v|--verbose)
            verbose=true
            shift
            ;;
        -q|--quick)
            quick=true
            shift
            ;;
        -*)
            echo "Unknown option: $1" >&2
            help_info
            exit 1
            ;;
        *)
            echo "Error: Unexpected argument: $1" >&2
            help_info
            exit 1
            ;;
    esac
done

# Test result tracking
passed_tests=0
failed_tests=0
skipped_tests=0

# Test result functions
test_pass() {
    local message="$1"
    echo "✅ $message"
    ((passed_tests++))
}

test_fail() {
    local message="$1"
    local details="${2:-}"
    echo "❌ $message"
    if [[ -n "$details" ]]; then
        echo "   $details"
    fi
    ((failed_tests++))
}

test_skip() {
    local message="$1"
    echo "⏭️  $message"
    ((skipped_tests++))
}

verbose_output() {
    if [[ "$verbose" == "true" ]]; then
        echo "   $1"
    fi
}

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m' # No Color

# Test execution starts
echo -e "${MAGENTA}🧪 Testing Windows Bundling System"
echo -e "${MAGENTA}======================================${NC}"

# Test 1: Check if required files exist
echo -e "${BLUE}1. File Existence Checks${NC}"

required_files=(
    "bundle"
    "lib/blob-store.sh"
)

for file in "${required_files[@]}"; do
    file_path="$(dirname "$0")/$file"
    if [[ -f "$file_path" ]]; then
        test_pass "Required file exists: $file"
        verbose_output "Path: $file_path"
    else
        test_fail "Required file missing: $file" "Expected at: $file_path"
    fi
done

# Test 2: Bash syntax validation
echo -e "${NC}"
echo -e "${BLUE}2. Bash Syntax Validation${NC}"

syntax_test_files=(
    "bundle"
)

for file in "${syntax_test_files[@]}"; do
    file_path="$(dirname "$0")/$file"
    verbose_output "Testing syntax for: $file"

    if bash -n "$file_path" 2>/dev/null; then
        test_pass "Syntax OK: $file"
    else
        test_fail "Syntax error in: $file"
    fi
done

# Test 3: Environment setup
echo -e "${NC}"
echo -e "${BLUE}3. Environment Setup${NC}"

# Check if we're in the correct directory
if [[ -f "$(dirname "$0")/../../crates/oppla/RELEASE_CHANNEL" ]]; then
    test_pass "Project structure valid"
    verbose_output "Found crates/oppla directory"
else
    test_fail "Invalid project structure" "Expected to find crates/oppla directory"
fi

# Check RELEASE_CHANNEL file
channel_file="$(dirname "$0")/../../crates/oppla/RELEASE_CHANNEL"
if [[ -f "$channel_file" ]]; then
    channel=$(cat "$channel_file" | tr -d '\n\r')
    if [[ "$channel" =~ ^(stable|preview|nightly|dev)$ ]]; then
        test_pass "Valid release channel: $channel"
    else
        test_fail "Invalid release channel: $channel" "Expected: stable, preview, nightly, or dev"
    fi
else
    test_fail "RELEASE_CHANNEL file missing" "Expected at: $channel_file"
fi

# Test 4: Dependency checks
echo -e "${NC}"
echo -e "${BLUE}4. Dependency Checks${NC}"

# Check for Rust
rust_tools=("cargo" "rustc" "rustup")
for tool in "${rust_tools[@]}"; do
    if command -v "$tool" >/dev/null 2>&1; then
        test_pass "Rust tool available: $tool"
        tool_path=$(command -v "$tool")
        verbose_output "Path: $tool_path"
        if [[ "$verbose" == "true" ]]; then
            version=$("$tool" --version 2>/dev/null || echo "version unknown")
            verbose_output "Version: $version"
        fi
    else
        test_fail "Rust tool not found: $tool"
    fi
done

# Check for bash (we're running it, so it should exist)
test_pass "Bash available" "Version: $BASH_VERSION"

# Check for compression tools
if command -v zip >/dev/null 2>&1; then
    test_pass "ZIP compression available"
elif command -v tar >/dev/null 2>&1; then
    test_pass "TAR compression available (ZIP not found)"
else
    test_fail "No compression tools found" "Need zip or tar"
fi

# Test 5: Blob store function validation
echo -e "${NC}"
echo -e "${BLUE}5. Blob Store Functions${NC}"

# Source blob-store functions
script_dir="$(dirname "$0")"
if [[ -f "$script_dir/lib/blob-store.sh" ]]; then
    # shellcheck source=lib/blob-store.sh
    source "$script_dir/lib/blob-store.sh"

    # Check if functions are defined
    functions=("upload_to_blob_store" "upload_to_blob_store_public" "upload_to_blob_store_with_acl")
    for func in "${functions[@]}"; do
        if declare -f "$func" >/dev/null 2>&1; then
            test_pass "Function defined: $func"
        else
            test_fail "Function not defined: $func"
        fi
    done
else
    test_fail "Cannot source blob-store functions" "File not found"
fi

# Test 6: Version extraction functionality
echo -e "${NC}"
echo -e "${BLUE}6. Version Extraction${NC}"

version_script="$(dirname "$0")/../get-crate-version"
if [[ -f "$version_script" ]]; then
    # Try to get version (may fail if workspace not built)
    if version_output=$("$version_script" oppla 2>/dev/null) && [[ "$version_output" =~ ^[0-9]+\.[0-9]+\.[0-9]+ ]]; then
        test_pass "Version extraction works" "Version: $version_output"
        verbose_output "Version script returned: $version_output"
    else
        test_skip "Version extraction test" "Cargo workspace may not be built yet"
        verbose_output "Version output: $version_output"
    fi
else
    test_fail "Version extraction script missing" "Expected at: $version_script"
fi

# Test 7: Directory structure
echo -e "${NC}"
echo -e "${BLUE}7. Directory Structure${NC}"

required_dirs=(
    "lib"
    "resources"
)

for dir in "${required_dirs[@]}"; do
    dir_path="$(dirname "$0")/$dir"
    if [[ -d "$dir_path" ]]; then
        test_pass "Directory exists: $dir"
    else
        test_fail "Directory missing: $dir" "Expected at: $dir_path"
    fi
done

# Test 8: Target directory setup
echo -e "${NC}"
echo -e "${BLUE}8. Target Directory Setup${NC}"

target_dir="target/release"
if [[ -d "$target_dir" ]]; then
    test_pass "Target directory exists"
else
    test_skip "Target directory missing" "This is normal before first build"
fi

# Test 9: Windows target support
echo -e "${NC}"
echo -e "${BLUE}9. Windows Target Support${NC}"

windows_targets=("x86_64-pc-windows-msvc" "i686-pc-windows-msvc" "aarch64-pc-windows-msvc")
have_windows_targets=false

if command -v rustup >/dev/null 2>&1; then
    for target in "${windows_targets[@]}"; do
        if rustup target list --installed 2>/dev/null | grep -q "$target"; then
            test_pass "Windows target installed: $target"
            have_windows_targets=true
            verbose_output "Target $target is available for compilation"
        else
            verbose_output "Windows target not installed: $target"
        fi
    done

    if [[ "$have_windows_targets" == "false" ]]; then
        test_skip "No Windows targets installed" "Run: rustup target add x86_64-pc-windows-msvc"
    fi
else
    test_skip "rustup not available" "Cannot check Windows targets"
fi

# Test 10: Script execution
echo -e "${NC}"
echo -e "${BLUE}10. Script Execution${NC}"

# Check if we can execute the main bundle script (help only)
bundle_script="$(dirname "$0")/bundle"
if [[ -f "$bundle_script" ]] && [[ -x "$bundle_script" ]]; then
    if test_output=$("$bundle_script" --help 2>&1) && [[ "$test_output" =~ "Usage:" ]]; then
        test_pass "Bundle script executes correctly"
        verbose_output "Script help output generated successfully"
    else
        test_fail "Bundle script execution failed" "Help output not found"
        verbose_output "Help output: $test_output"
    fi
else
    test_fail "Bundle script not executable or missing"
fi

# Test 11: Cross-compilation readiness
echo -e "${NC}"
echo -e "${BLUE}11. Cross-compilation Readiness${NC}"

# Check if we have proper tooling for Windows cross-compilation
host_target=$(rustc --version --verbose 2>/dev/null | grep -E "^host:" | cut -d' ' -f2 || echo "unknown")
verbose_output "Host target: $host_target"

# Check for mingw or other Windows toolchain dependencies
if command -v x86_64-w64-mingw32-gcc >/dev/null 2>&1; then
    test_pass "MinGW toolchain available for Windows cross-compilation"
elif command -v clang >/dev/null 2>&1; then
    test_skip "Clang available (MSVC target should work in CI)"
else
    test_skip "No Windows cross-compilation toolchain found" "Will rely on CI builds"
fi

# Test 12: Archive creation tools
echo -e "${NC}"
echo -e "${BLUE}12. Archive Creation Tools${NC}"

archive_tools_available=0

if command -v zip >/dev/null 2>&1; then
    test_pass "ZIP tool available"
    ((archive_tools_available++))
    verbose_output "ZIP version: $(zip --version | head -1)"
fi

if command -v tar >/dev/null 2>&1; then
    test_pass "TAR tool available"
    ((archive_tools_available++))
    verbose_output "TAR version: $(tar --version | head -1)"
fi

if [[ $archive_tools_available -eq 0 ]]; then
    test_fail "No archive creation tools found"
else
    test_pass "Archive creation tools available ($archive_tools_available)"
fi

# Test 13: File permissions
echo -e "${NC}"
echo -e "${BLUE}13. File Permissions${NC}"

bundle_script_path="$(dirname "$0")/bundle"
if [[ -f "$bundle_script_path" ]]; then
    if [[ -x "$bundle_script_path" ]]; then
        test_pass "Bundle script is executable"
    else
        test_fail "Bundle script is not executable" "Run: chmod +x $bundle_script_path"
    fi
else
    test_fail "Bundle script not found"
fi

# Test summary
echo -e "${NC}"
echo -e "${MAGENTA}📊 Test Summary"
echo -e "${MAGENTA}==============${NC}"
echo -e "${GREEN}✅ Passed: $passed_tests${NC}"
echo -e "${RED}❌ Failed: $failed_tests${NC}"
echo -e "${CYAN}⏭️  Skipped: $skipped_tests${NC}"
echo -e "Total:   $((passed_tests + failed_tests + skipped_tests))${NC}"

# Overall result
if [[ $failed_tests -eq 0 ]]; then
    echo -e "${NC}"
    echo -e "${GREEN}🎉 All tests passed! Windows bundling system is ready.${NC}"
    if [[ "$quick" != "true" ]]; then
        echo -e "${NC}"
        echo -e "${YELLOW}Next steps:${NC}"
        echo -e "  1. ${WHITE}Install Windows targets: rustup target add x86_64-pc-windows-msvc${NC}"
        echo -e "  2. ${WHITE}Run the bundler: $(dirname "$0")/bundle${NC}"
        echo -e "  3. ${WHITE}For local development: $(dirname "$0")/bundle --local-only${NC}"
    fi
    exit 0
else
    echo -e "${NC}"
    echo -e "${RED}⚠️  $failed_tests test(s) failed. Please fix the issues before using the bundler.${NC}"
    if [[ "$verbose" == "true" ]]; then
        echo -e "${NC}"
        echo -e "${YELLOW}Run with --verbose for more detailed information.${NC}"
    fi
    exit 1
fi
